+/** CSV (identifiant, nom, mot de passe, lien) des accès qui viennent d'être créés, en lien de téléchargement. */
+function ins_csv_nouveaux_acces(array $form, array $liste): string
+{
+    $sep = (string)ins_config()['separateur'];
