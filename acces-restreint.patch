@@ -0,0 +1,49 @@
+; =====================================================================
+; Exemple de formulaire à ACCÈS RESTREINT : réponse des membres à la
+; convocation de l'assemblée générale.
+;
+; - acces = personnel : chaque membre reçoit un lien personnel ET un mot de passe ;
+;   acces = lien      : chaque membre reçoit seulement un lien personnel secret.
+; - les accès se créent dans admin.php (rubrique « Gérer les accès » de ce formulaire),
+;   à partir d'une liste de noms ou d'adresses ; la liste (identifiants, mots de passe, liens)
+;   se télécharge en CSV pour être diffusée hors de l'application (publipostage, courrier…).
+; - une seule réponse par accès ; avec modifiable = oui (défaut), le membre peut revenir
+;   modifier sa réponse jusqu'à la fermeture.
+; - le fichier des réponses contient l'identifiant et le nom de l'accès (colonnes acces, acces_nom).
+; - un formulaire à accès restreint n'apparaît jamais dans la liste publique.
+; =====================================================================
+
+[formulaire]
+titre      = "Assemblée générale du 14 février 2027 — réponse des membres"
+intro      = "Merci de nous indiquer votre présence avant le 7 février. Vous pourrez modifier votre réponse jusqu'à cette date."
+acces      = personnel
+modifiable = oui
+fermeture  = "2027-02-07"
+merci      = "Merci, votre réponse est enregistrée."
+bouton     = "Enregistrer ma réponse"
+
+[presence]
+type        = choix
+libelle     = "Serez-vous présent(e) ?"
+options     = "Oui | Non, je donne pouvoir | Non"
+obligatoire = oui
+
+[mandataire]
+type        = texte
+libelle     = "Nom du membre à qui vous donnez pouvoir"
+obligatoire = oui
